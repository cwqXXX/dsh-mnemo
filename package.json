{
  "name": "dsh-mnemo",
  "version": "0.2.0",
  "description": "给 DeepSeek Harness 的跨会话长期记忆：规则钉住、按证据召回、事实键去重、明文可读，带管理页。",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "agent"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
